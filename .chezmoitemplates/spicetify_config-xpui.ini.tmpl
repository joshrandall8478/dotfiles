[Patch]

[Setting]
always_enable_devtools = 0
{{ if eq .chezmoi.os "windows" -}}
spotify_path           = {{ .chezmoi.homeDir }}\AppData\Roaming\Spotify
prefs_path             = {{ .chezmoi.homeDir }}\AppData\Roaming\Spotify\prefs
color_scheme           = Spotify
{{ else -}}
spotify_path           = /opt/spotify/
prefs_path             = {{ .chezmoi.homeDir }}/.config/spotify/prefs
color_scheme           = TokyoNight
{{ end -}}
current_theme          = text
inject_theme_js        = 1
inject_css             = 1
overwrite_assets       = 0
check_spicetify_update = 1
replace_colors         = 1
spotify_launch_flags   =

[Preprocesses]
disable_ui_logging = 1
remove_rtl_rule    = 1
expose_apis        = 1
disable_sentry     = 1

[AdditionalOptions]
home_config           = 1
experimental_features = 1
extensions            =
custom_apps           = marketplace|wave-visualizer
sidebar_config        = 0

; DO NOT CHANGE!
[Backup]
{{ if eq .chezmoi.os "windows" -}}
version = 1.2.93.667.g7b5cc0ce
{{ else -}}
version = 1.2.92.147.g5b8f9367
{{ end -}}
